# ============================================================
# BRAHMO Rules Engine — Environment Template
# Copy this file to .env.local (or .env) and fill in real values.
# NEVER commit the filled-in file.
# ============================================================

# --- Backend (FastAPI) ---
# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service_role key (backend only — bypasses RLS, keep secret)
# Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_KEY=

# Org id to run the pipeline for (matches organizations.id in seed data)
DEFAULT_ORG_ID=supra

# Port the FastAPI app listens on
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
# Public Supabase URL + anon key (safe for browser, RLS-protected)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL the frontend uses to reach the FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
